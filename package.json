{
  "name": "zenon-bridge-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Front end for the Zenon Network of Momentum multichain bridge.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/release-manifest.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:swap": "node e2e/swap.fork.mjs",
    "lab:up": "bash e2e/lab/lab.sh up",
    "lab:down": "bash e2e/lab/lab.sh down",
    "lab:status": "bash e2e/lab/lab.sh status",
    "lab:wipe": "bash e2e/lab/lab.sh wipe",
    "lint": "eslint src tests e2e scripts vite.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node tests/browser/run.mjs",
    "lab:build:native": "node e2e/lab/build.mjs native",
    "lab:native": "node e2e/lab/native.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@lucide/vue": "1.66.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "bech32": "^2.0.0",
    "viem": "^2.57.13",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "@scure/bip39": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "puppeteer-core": "25.16.0",
    "solc": "0.8.38",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7",
      "follow-redirects": "1.16.2"
    },
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
